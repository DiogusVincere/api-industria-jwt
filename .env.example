# Copie para .env (ou exporte no ambiente) e ajuste. Nenhum valor aqui é secreto.
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# True só em desenvolvimento
DEBUG=True
# Hosts aceitos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS: True libera qualquer origem (padrão). Para restringir, False + lista de origens.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
# Origens confiáveis para o CSRF (admin/API navegável atrás de HTTPS), separadas por vírgula.
# Ex.: https://*.onrender.com
CSRF_TRUSTED_ORIGINS=
# True só atrás de um proxy que termina o HTTPS e manda X-Forwarded-Proto (Render, Heroku).
USE_X_FORWARDED_PROTO=False
